{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart": "node scripts/prepare-docs.mjs",
    "start": "node scripts/docs-cli.mjs dev --no-open --disable-prefetch",
    "prebuild": "node scripts/prepare-docs.mjs",
    "build": "node scripts/docs-cli.mjs validate",
    "build:fast": "npm run build",
    "validate": "node scripts/docs-cli.mjs validate",
    "check:links": "node scripts/docs-cli.mjs broken-links --check-anchors --check-snippets --check-redirects",
    "typecheck": "tsc -p . --noEmit",
    "lint:diagrams": "ascii-guard lint --exclude-code-blocks docs",
    "preexport": "node scripts/prepare-docs.mjs",
    "export": "node scripts/export-docs.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "prerelease:source": "node scripts/prepare-docs.mjs",
    "release:source": "node scripts/release-source.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "mint": "4.2.1176",
    "esbuild": "0.28.2",
    "@mdx-js/mdx": "3.1.1",
    "remark-gfm": "4.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-directive": "4.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "typescript": "6.0.3",
    "@types/react": "19.2.14",
    "js-yaml": "4.3.2",
    "react": "19.2.3",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "@mintlify/common": "1.0.1328",
    "react-dom": "19.2.3",
    "@mintlify/previewing": "4.0.1584",
    "@mintlify/prebuild": "1.0.1500",
    "express": "4.22.0"
  },
  "engines": {
    "node": ">=26.0",
    "npm": ">=11.17.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
